{
  // The LamTo demo in GitHub Codespaces: one click, then the Resident app,
  // the Management workspace and the demo kit at a public address.
  // Scripts: ops/codespace/. No ClamAV, no chain, no AI, no push.
  "name": "LamTo demo",
  // GitHub's default Codespaces image: Docker, gh and python3 are already in
  // it, and it is cached on Codespaces hosts, so nothing is installed here.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "forwardPorts": [80],
  "portsAttributes": {
    "80": { "label": "LamTo demo", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash ops/codespace/prepare.sh",
  "postStartCommand": "bash ops/codespace/start.sh",
  "postAttachCommand": "bash ops/codespace/show.sh",
  "customizations": {
    "codespaces": { "openFiles": ["ops/codespace/README.md"] }
  }
}
